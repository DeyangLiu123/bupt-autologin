{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BUPT Autologin",
  "version": "0.1.4",
  "identifier": "io.github.deyangliu123.buptautologin",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "北邮校园网掉线自动认证",
    "longDescription": "常驻托盘，检测到北邮校园网 (buptportal) 未认证时自动登录。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1"]
      }
    }
  }
}
